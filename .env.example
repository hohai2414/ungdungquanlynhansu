# Vercel: create a remote libSQL database in Turso and set these in project settings.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-in-vercel-settings
# At least 5 characters for demo use; used ONLY on first initialization of an empty database.
DEMO_PASSWORD=replace-with-your-own-strong-password
